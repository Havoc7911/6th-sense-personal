# Create a Supabase project: https://supabase.com/dashboard
# Project Settings → API: copy Project URL and anon public key.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Magic link sign-in (client /portal): Supabase → Authentication → URL Configuration
# Add to "Redirect URLs" (adjust ports/domains as needed):
#   http://localhost:5173/portal
#   https://YOUR-VERCEL-APP.vercel.app/portal
